{% extends "base.html.j2" %}
{% block content %}
{% from "macros/user_macros.html.j2" import user_display%}

<div class="container mt-5">

  <!-- User Profile Information Card -->
  <div class="card col-lg-8 mx-auto">
    <div class="row g-0 align-items-center">
      <div class="col-md-12">
        <div class="card-body">
          <h2 class="card-title">User settings</h2>
        {% if session.user_id %}
          <form action="{{ url_for('set_profile_picture') }}" method="POST">
            <div class="mb-3">
            <textarea class="form-control" name="content" rows="1" placeholder="Profile picture URL" required>{{ user.avatarurl }}</textarea>
            </div>
            <button type="submit" class="btn btn-primary float-end">Update</button>
          </form>
          <br>
          <form action="{{ url_for('remove_profile_picture') }}" method="POST">
            <button type="submit" class="btn btn-primary">Remove profile picture</button>
          </form>
        {% else %}
          <p>You are not logged in.</p> 
        {% endif %}

        </div>
      </div>
    </div>
  </div>

</div>
{% endblock %}
